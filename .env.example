# ==============================================================================
# Plantilla de variables de entorno — Sistema de Gestión Clínica (Equipo 01)
# Copia este archivo como ".env" (o ejecuta .\scripts\setup_db.ps1) y ajusta
# los valores para tu entorno local o Google Cloud Platform.
# NUNCA subas el archivo ".env" real a Git.
# ==============================================================================

# Flask
FLASK_SECRET_KEY=cambia-esta-clave-secreta-por-una-aleatoria
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# PostgreSQL (Local o Cloud SQL for PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=BD
DB_USER=usuario
DB_PASSWORD=cambia-esta-contrasena-local
DB_SSLMODE=prefer

# MongoDB (Local o MongoDB Atlas en GCP — Fase 4)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=clinica_salud_mental
